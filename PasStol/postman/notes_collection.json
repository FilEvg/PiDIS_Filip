{
  "info": {
    "_postman_id": "5f1c0a2e-7b34-4d69-9a01-6c8e2b4d00a5",
    "name": "АИС «Паспортный стол» — API notes (Прил_5)",
    "description": "Коллекция проверяет работоспособность API GET /api/notes: штатный ответ 200, пустой массив [] при отсутствии данных, 400 при некорректном параметре, 500 при внутренней ошибке, а также валидность JSON в каждом ответе.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "Заметки — список (200, валидность JSON, формат полей)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200 при штатной работе', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Ответ является валидным JSON', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "    JSON.parse(pm.response.text());",
              "});",
              "pm.test('Поля обработаны по правилам Прил_5', function () {",
              "    var body = pm.response.json();",
              "    pm.expect(Array.isArray(body)).to.eql(true);",
              "    if (body.length > 0) {",
              "        var note = body[0];",
              "        pm.expect(note).to.have.property('id');",
              "        pm.expect(note).to.have.property('title_user');",
              "        pm.expect(note).to.have.property('content');",
              "        pm.expect(note).to.have.property('formatted_date');",
              "        pm.expect(note.title_user).to.include(' - ');",
              "        pm.expect(note.formatted_date).to.match(/^\\d{2}\\.\\d{2}\\.\\d{4}$/);",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/notes", "host": ["{{baseUrl}}"], "path": ["api", "notes"] }
      }
    },
    {
      "name": "Заметки — данных нет (200 и пустой массив [])",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200 при отсутствии данных', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Ответ является валидным JSON', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "    JSON.parse(pm.response.text());",
              "});",
              "pm.test('Тело ответа — пустой массив', function () {",
              "    pm.expect(pm.response.json()).to.eql([]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/notes?id=999999",
          "host": ["{{baseUrl}}"],
          "path": ["api", "notes"],
          "query": [ { "key": "id", "value": "999999" } ]
        }
      }
    },
    {
      "name": "Заметки — некорректный параметр id (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 400 при некорректном запросе', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test('Ответ является валидным JSON с описанием ошибки', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "    var body = JSON.parse(pm.response.text());",
              "    pm.expect(body).to.have.property('error');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/notes?id=abc",
          "host": ["{{baseUrl}}"],
          "path": ["api", "notes"],
          "query": [ { "key": "id", "value": "abc" } ]
        }
      }
    },
    {
      "name": "Заметки — внутренняя ошибка сервера (500)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 500 при внутренней ошибке', function () {",
              "    pm.response.to.have.status(500);",
              "});",
              "pm.test('Ответ является валидным JSON с сообщением об ошибке', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "    var body = JSON.parse(pm.response.text());",
              "    pm.expect(body).to.have.property('error');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/notes?simulate_error=1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "notes"],
          "query": [ { "key": "simulate_error", "value": "1" } ]
        }
      }
    }
  ]
}